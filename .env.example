# PostgreSQL
POSTGRES_USER=rms_user
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=postgres
AUDIT_DB_PASSWORD=postgres

# JWT Secret (HS256 - at least 64 characters)
JWT_SECRET=super_secret_jwt_key_recruitment_system_64_characters_long_key!

# RabbitMQ
RABBITMQ_USER=rms_rabbit
RABBITMQ_PASSWORD=rabbitpass

# Redis
REDIS_PASSWORD=redispass

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# SMTP (Optional / Dev)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=password

# Frontend URL
FRONTEND_BASE_URL=http://localhost:5173

# Internal Service Secrets
OFFER_TO_ATS_SECRET=uuid-offer-to-ats-secret-12345
INTERNAL_SECRET=uuid-internal-secret-12345

# Sysadmin Initial Credentials
SYSADMIN_EMAIL=sysadmin@rms.local
SYSADMIN_INITIAL_PASSWORD=Password123!
