# PostgreSQL
POSTGRES_USER=rms_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
AUDIT_DB_PASSWORD=CHANGE_ME_AUDIT_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_64_CHAR_MINIMUM_SECRET_KEY_FOR_HS256_ALGORITHM

# RabbitMQ
RABBITMQ_USER=rms_rabbit
RABBITMQ_PASSWORD=CHANGE_ME

# Redis (shared by Gateway rate limiter, IAM JWT blacklist, Offer idempotency interceptor)
REDIS_PASSWORD=CHANGE_ME
# REDIS_HOST and REDIS_PORT default to rms-redis:6379 in application.yml; override here only if needed

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=CHANGE_ME

# App
FRONTEND_BASE_URL=http://localhost:3000

# Internal service-to-service authentication (SEC-04 deviation — FINDING-03)
# Each secret is directional. MUST be changed from placeholder before deployment.
# Services validate at startup that the value does not start with "CHANGE_ME".
OFFER_TO_ATS_SECRET=CHANGE_ME_RANDOM_UUID_FOR_OFFER_TO_ATS
INTERNAL_SECRET=CHANGE_ME_RANDOM_UUID_FOR_INTERNAL_CALLS

# SYS_ADMIN Bootstrap (Q5 resolved — v1.2)
# Created by IAM Service on first startup if no SYS_ADMIN exists.
# Force-change password on first login is enforced.
SYSADMIN_EMAIL=sysadmin@rms.internal
SYSADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_INITIAL_PASSWORD
